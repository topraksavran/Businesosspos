{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BusinessOS",
  "version": "0.1.0",
  "identifier": "com.northstaragency.businessos",
  "build": {
    "frontendDist": "..",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "python3 -m http.server 8080 --directory .."
  },
  "app": {
    "windows": [{
      "title": "BusinessOS",
      "width": 1440,
      "height": 900,
      "minWidth": 1100,
      "minHeight": 700,
      "resizable": true
    }],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false
  }
}
