{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BusinessOS POS",
  "version": "0.1.0",
  "identifier": "com.northstaragency.businessos.pos",
  "build": {
    "frontendDist": "../../pos",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "python3 -m http.server 8080 --directory ../../pos"
  },
  "app": {
    "windows": [
      {
        "title": "BusinessOS POS",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
  "active": true,
  "targets": "all",
  "icon": [
  "icons/icon.ico"
],
  "createUpdaterArtifacts": false
}
}
